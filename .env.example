# 운영 .env 예시. 변수 하나하나의 뜻과 만드는 법은 docs/operations.md 1절. 실제 파일은 Jenkins 워크스페이스(oracle 호스트의
# /var/jenkins_home/workspace/sandcorp-auth/.env)에만 둔다. 저장소에 넣지 않는다.

# Django
DJANGO_SECRET_KEY=change-me-50-random-chars
DJANGO_ALLOWED_HOSTS=auth.sandcorp.co.kr
DJANGO_CSRF_TRUSTED_ORIGINS=https://auth.sandcorp.co.kr
# Django admin 경로(추측하기 어려운 값, 끝의 / 생략 가능)
DJANGO_ADMIN_PATH=change-me-admin-path
# 서비스의 절대 URL(이후 JWT의 iss가 된다). 생략하면 https://auth.sandcorp.co.kr
SITE_URL=https://auth.sandcorp.co.kr
# 서명 개인 키를 DB에 암호화해 두는 Fernet 키(필수). 만들기:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# 바꾸면 기존 서명 키를 복호화할 수 없다(새로 signing_keys rotate 해야 한다).
SIGNING_KEY_ENCRYPTION_KEY=change-me-fernet-key
# 로그인 세션 수명(초, 선택). 기본 604800(7일). 로그인 시각부터 세며 활동해도 늘지 않고, 브라우저를 닫아도 유지된다.
# SESSION_AGE_SECONDS=604800
# 호출자 IP를 X-Forwarded-For 첫 값으로 볼지(NPMplus 뒤라 기본 1). 직접 노출할 때만 0.
# TRUST_X_FORWARDED_FOR=1
# DJANGO_LOG_LEVEL=INFO
# 로컬 확인 때만: http로 /authorize·/token을 받게 한다. 운영 .env에는 넣지 않는다(docs/operations.md 8절).
# AUTHLIB_INSECURE_TRANSPORT=1
# GUNICORN_WORKERS=2

# MySQL(운영: OCI MySQL HeatWave, 같은 VCN의 사설 IP. DB는 utf8mb4 / utf8mb4_0900_as_cs로 만든다).
# make prod-local은 docker-compose.prod-local.yml의 로컬 MySQL을 띄우고 DB_HOST·DB_PORT를 그쪽으로 덮는다
# (DB_PASSWORD가 그 컨테이너의 앱 계정 비밀번호가 된다).
DB_HOST=10.0.0.10
DB_PORT=3306
DB_NAME=sandcorp_auth
DB_USER=sandcorp_auth
DB_PASSWORD=change-me

# web 바인딩(기본: oracle 덮어쓰기에서 172.17.0.1:18093)
# HTTP_BIND=172.17.0.1
# HTTP_PORT=18093
